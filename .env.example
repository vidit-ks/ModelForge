# ==========================================
# ModelForge Global Environment Configuration
# ==========================================

# Hugging Face Inference Token (Required for Live HF Provider inference)
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_access_token_here

# Supabase Credentials (Optional for cloud sync; Local Sandbox works out-of-the-box)
# Get yours at https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Backend Port
PORT=5000
